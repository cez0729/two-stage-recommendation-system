data/processed/*
data/feedback/*
artifacts/*
models/*
runs/*

# Keep compact research evidence, not row-level evaluation exports or QA renders
results/**/*.parquet
reports/qa/
reports/rendered_final_report/
reports/next_phase_spec_extracted.txt
reports/final_research_report_zh.pdf
two_stage_recommender_codex_spec_zh.docx

# Keep directory explanations/placeholders
!data/**/.gitkeep
!artifacts/README.md
!models/README.md
!runs/README.md
