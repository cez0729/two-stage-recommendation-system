# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and local settings
.env
.env.*
!.env.example
*.pem
*.key
